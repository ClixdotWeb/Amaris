# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by API routes / webhooks to write orders. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Dashboard → Settings → API Keys)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks (events: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# Transactional email (Resend). If empty, emails are logged to the console instead.
RESEND_API_KEY=
EMAIL_FROM="Amaris Boutique <orders@your-domain.com>"
# Where new-order notifications go
ADMIN_NOTIFY_EMAIL=amarisbymarias@gmail.com

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
